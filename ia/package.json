{
  "name": "quatrieme-jour-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Partie A — IA/Backend : analyse repo (M2), mapping rêve (M3.3), moteur de Signaux (M4), lettre du futur (M7)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node --enable-source-maps dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "smoke": "tsx src/tests/smoke.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
