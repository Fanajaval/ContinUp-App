# ─── Serveur ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=dev-secret-a

# ─── PostgreSQL (même BDD que le backend Auth) ──────────────
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/restart
PGSSL=0

# ─── LLM (compatible OpenAI : OpenAI, Groq, Mistral, OpenRouter…) ──
LLM_API_KEY=
# Groq :
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=25000
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7

# Mode dégradé forcé : 1 = zéro appel réseau, on sert les fallbacks
LLM_OFFLINE=0

# ─── GitHub (lecture repo public ; token optionnel) ──
GITHUB_TOKEN=
