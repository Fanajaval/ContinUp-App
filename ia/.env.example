# ─── Serveur ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=dev-secret-a

# ─── PostgreSQL (même BDD que le backend Auth) ──────────────
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/restart
PGSSL=0

# ─── LLM — Google Gemini (Google AI Studio) ─────────────────
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Modèle recommandé : gemini-3.5-flash-lite (léger, nouveaux comptes) ou gemini-flash-latest
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.4

# Mode dégradé forcé : 1 = zéro appel réseau, on sert les fallbacks
LLM_OFFLINE=0

# ─── GitHub (lecture repo public ; token optionnel) ──
GITHUB_TOKEN=
