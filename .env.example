# ===========================================
# ENVIRONMENT VARIABLES
# Copie ce fichier en .env et remplis les valeurs
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reve_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reve_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# GitHub OAuth (optionnel — on commence en URL publique)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# GitHub Personal Access Token (pour accéder aux repos via l'API)
GITHUB_TOKEN=

# AI Service (OpenAI-compatible)
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_RETRIES=3
AI_TIMEOUT=30000

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@tonprojet.com
EMAIL_ENABLED=false

# Frontend URL (pour les liens dans les emails)
FRONTEND_URL=http://localhost:5173

# Cron
CRON_SILENCE_CHECK=0 */6 * * *
