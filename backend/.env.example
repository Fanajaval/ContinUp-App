PORT=5000

# Format utilisé par le module TypeScript (src/)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/restart

# Format utilisé par Sequelize (Auth)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restart
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
